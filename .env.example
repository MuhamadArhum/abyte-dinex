# =============================================================
# Abyte ERP — Environment Variables Template
# Copy to .env and fill in all required values before running.
# Never commit .env to version control.
# =============================================================

# ── Database (MariaDB/MySQL) ──────────────────────────────────
# REQUIRED
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=abyte_pos

# Optional: TLS for remote DB
# DB_SSL_CA=./certs/ca.pem

# ── JWT ────────────────────────────────────────────────────────
# REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ── AI Providers (at least one required for AI features) ───────
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Frontend (Vite) ────────────────────────────────────────────
# Printer Agent URL — override if agent runs on a different host/port
# Default: http://localhost:3001
VITE_PRINTER_AGENT_URL=http://localhost:3001

# ── Docker / Compose ───────────────────────────────────────────
FRONTEND_PORT=80

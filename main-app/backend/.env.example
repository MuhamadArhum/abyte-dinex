# =============================================================
# Abyte Dinex — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================

# ── Server ────────────────────────────────────────────────────
# Port the Express server listens on
PORT=5000

# Set to "production" in prod, "development" locally, "test" in CI
NODE_ENV=production

# Comma-separated list of allowed CORS origins (no trailing slash)
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Public URL of the frontend (used in email links, etc.)
FRONTEND_URL=https://app.yourdomain.com

# ── Database ──────────────────────────────────────────────────
# MariaDB / MySQL connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here

# Tenant database name (default: abyte_pos)
DB_NAME=abyte_pos

# Master database holding tenants/config tables (default: abyte_master)
MASTER_DB_NAME=abyte_master

# Path to SSL CA certificate file (leave blank to disable SSL)
# DB_SSL_CA=/path/to/ca-cert.pem

# ── Authentication ────────────────────────────────────────────
# REQUIRED: 64-byte hex secret for signing JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_generate_with_crypto_randomBytes_64

# How long JWT tokens remain valid (e.g. 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# ── Email (Nodemailer) ────────────────────────────────────────
# SMTP server settings for transactional email
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_password_here
EMAIL_FROM=noreply@yourdomain.com

# ── Logging ───────────────────────────────────────────────────
# Log level: error | warn | info | http | debug
LOG_LEVEL=info

# Directory for log files (relative to backend root, or absolute path)
# LOG_DIR=logs

# ── File Storage ──────────────────────────────────────────────
# Storage provider: local | s3 | r2 | minio
STORAGE_PROVIDER=local

# Local uploads directory (used when STORAGE_PROVIDER=local)
# UPLOADS_DIR=uploads

# S3 / R2 / MinIO settings (only needed when STORAGE_PROVIDER != local)
# STORAGE_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Cloudflare R2 account ID (only needed for Cloudflare R2)
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# MinIO endpoint (only needed when STORAGE_PROVIDER=minio)
# MINIO_ENDPOINT=http://localhost:9000

# ── Backups ───────────────────────────────────────────────────
# Directory where database backups are stored
# BACKUPS_DIR=backups

# Path to mysqldump / mariadb-dump binary (leave blank to use PATH)
# MARIADB_DUMP_PATH=/usr/bin/mariadb-dump

# ── Redis / Caching ───────────────────────────────────────────
# Redis connection URL (leave blank to use in-memory cache)
# REDIS_URL=redis://localhost:6379

# ── AI / LLM ─────────────────────────────────────────────────
# Groq API key for AI features (optional)
# GROQ_API_KEY=your_groq_api_key_here

# ── Security ─────────────────────────────────────────────────
# 32-byte hex key for encrypting sensitive data at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ── Metrics / Monitoring ──────────────────────────────────────
# Bearer token to protect the /metrics endpoint (optional)
# METRICS_TOKEN=your_metrics_token_here
